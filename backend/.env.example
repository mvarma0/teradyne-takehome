APP_ENV=dev

# ---- Models: choose openai or ollama per component -------------------------
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# LLM (enrichment, answers, reranking)
LLM_PROVIDER=openai          # openai | ollama
LLM_MODEL=gpt-4o-mini        # ollama example: qwen2.5:7b
LLM_TEMPERATURE=0

# Embeddings (changing these needs a re-ingest; collections are per-model)
EMBEDDING_PROVIDER=openai             # openai | ollama
EMBEDDING_MODEL=text-embedding-3-small  # ollama: nomic-embed-text

# ---- Ingestion: docling + structure-aware recursive chunking (tokens) ------
USE_DOCLING=true
CHUNK_MAX_TOKENS=512        # upper bound; sections under this stay whole
CHUNK_MIN_TOKENS=80         # smaller sections merge with their neighbour
CHUNK_OVERLAP_TOKENS=64     # overlap only when an oversized section is split
ENRICH_MAX_CHARS=12000

# ---- Retrieval: semantic + BM25 -> weighted RRF -> LLM rerank --------------
TOP_K=6
CANDIDATE_K=20
SEMANTIC_WEIGHT=1.0
BM25_WEIGHT=1.0
RRF_K=60
RERANKER=llm                # llm | none
RERANK_TOP_N=10
RERANK_CONCURRENCY=4
RERANK_MAX_CHARS=1200

# ---- Answer quality (Exercise 2) -------------------------------------------
CONFIDENCE_THRESHOLD=0.55
MIN_RETRIEVAL_SCORE=0.25

# ---- Storage (relative paths resolve from backend/) ------------------------
DATA_DIR=../data
CHROMA_DIR=./storage/chroma
CHROMA_COLLECTION=fastchip
SQLITE_PATH=./storage/app.db

# ---- API --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
