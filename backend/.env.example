APP_ENV=dev                      # dev | test
OPENAI_API_KEY=

# LLM
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# Embeddings: openai | huggingface (huggingface needs `uv sync --extra local`)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Chunking / retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
CONFIDENCE_THRESHOLD=0.55
MIN_RETRIEVAL_SCORE=0.25

# Paths (relative to backend/)
DATA_DIR=../data
CHROMA_DIR=./storage/chroma
CHROMA_COLLECTION=fastchip
SQLITE_PATH=./storage/app.db

# API
CORS_ORIGINS=http://localhost:5173

# Quality alerts
ALERT_MIN_ANSWER_RATE=0.6
ALERT_MAX_REJECT_RATE=0.2
ALERT_MIN_MEAN_CONFIDENCE=0.5
ALERT_MAX_P95_LATENCY_MS=8000
ALERT_BASELINE_DROP_PCT=0.15
