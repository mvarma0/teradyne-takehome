APP_ENV=dev

# ---- Models ------------------------------------------------------------------
# A provider is any LangChain provider id. Built in: openai | google_genai | ollama.
# Others (anthropic, groq, mistralai, azure_openai, ...): `uv add langchain-<provider>`
# and set its key (e.g. ANTHROPIC_API_KEY). Presets:
#   OpenAI   LLM openai:gpt-4o-mini                    EMB openai:text-embedding-3-small
#   Google   LLM google_genai:gemini-3.1-flash-lite    EMB google_genai:gemini-embedding-001
#   Ollama   LLM ollama:qwen2.5:7b                     EMB ollama:nomic-embed-text
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# LLM (enrichment, answers, reranking)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_BASE_URL=               # optional: OpenAI-compatible endpoint (vLLM, LM Studio, GitHub Models)
LLM_API_KEY=                # optional: overrides the provider's own key variable
LLM_STRUCTURED_OUTPUT=auto  # auto | function_calling | json_schema | json_mode
LLM_MAX_RPM=0               # client-side requests/minute cap for rate-limited tiers (0 = off)
LLM_MAX_RETRIES=3

# Embeddings (changing these needs a re-ingest; collections are per-model)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ---- Ingestion: docling + structure-aware recursive chunking (tokens) ------
USE_DOCLING=true
CHUNK_MAX_TOKENS=512        # upper bound; sections under this stay whole
CHUNK_MIN_TOKENS=80         # smaller sections merge with their neighbour
CHUNK_OVERLAP_TOKENS=64     # overlap only when an oversized section is split
ENRICH_MAX_CHARS=12000

# ---- Retrieval: semantic + BM25 -> weighted RRF -> LLM rerank --------------
TOP_K=6
CANDIDATE_K=20
SEMANTIC_WEIGHT=1.0
BM25_WEIGHT=1.0
RRF_K=60
RERANKER=llm                # llm | none
RERANK_TOP_N=10
RERANK_CONCURRENCY=4
RERANK_MAX_CHARS=1200

# ---- Answering, guardrails, routing ----------------------------------------
CONFIDENCE_THRESHOLD=0.55   # below this an answer is "low confidence" -> routing + gap
MIN_RETRIEVAL_SCORE=0.25    # weak top semantic match caps confidence
HISTORY_MESSAGES=6          # chat turns used to rewrite follow-up questions
GUARDRAILS_LLM=true         # LLM input classifier (injection heuristics always run)
ROUTING_MAX_PEOPLE=3

# ---- Monitoring alerts -------------------------------------------------------
ALERT_MIN_ANSWER_RATE=0.6
ALERT_MAX_NEGATIVE_FEEDBACK_RATE=0.2
ALERT_MIN_MEAN_CONFIDENCE=0.5
ALERT_MIN_CITATION_VALID_RATIO=0.9
ALERT_MAX_P95_LATENCY_MS=20000
ALERT_BASELINE_DROP_PCT=0.15
ALERT_MIN_SAMPLES=5

# ---- Storage (relative paths resolve from backend/) ------------------------
DATA_DIR=../data
CHROMA_DIR=./storage/chroma
CHROMA_COLLECTION=fastchip
SQLITE_PATH=./storage/app.db

# ---- API --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
