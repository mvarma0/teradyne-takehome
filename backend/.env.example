# FastChip backend configuration
#
#   1. Pick ONE model preset below (A, B or C) and leave the others commented out.
#   2. Fill in that preset's key, if it has one.
#   3. Restart the server.
#
# Nothing else is required. Every other setting has a working default in app/config.py;
# uncomment a line in "Optional tuning" only to change it.

# =============================================================================
# 1. Models (required): choose one preset
# =============================================================================

# --- A. OpenAI (paid API key) -------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# --- B. Ollama (local and free, no key) ---------------------------------------
# First run: ollama pull qwen2.5:7b && ollama pull nomic-embed-text
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434

# --- C. Google Gemini (free tier available) -----------------------------------
# LLM_PROVIDER=google_genai
# LLM_MODEL=gemini-3.1-flash-lite
# EMBEDDING_PROVIDER=google_genai
# EMBEDDING_MODEL=gemini-embedding-001
# GOOGLE_API_KEY=
# LLM_MAX_RPM=15              # stay under the free tier's requests/minute

# Other providers (anthropic, groq, mistralai, ...): `uv add langchain-<provider>`,
# then set LLM_PROVIDER/LLM_MODEL and that provider's key, e.g. ANTHROPIC_API_KEY=.
# Changing the embedding model needs a re-ingest (Documents page -> Ingest changes).

# =============================================================================
# 2. Optional tuning: defaults shown, uncomment to override
# =============================================================================

# --- Model client ---
# LLM_TEMPERATURE=0
# LLM_BASE_URL=               # OpenAI-compatible endpoint (vLLM, LM Studio, GitHub Models)
# LLM_API_KEY=                # overrides the provider's own key variable
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# LLM_STRUCTURED_OUTPUT=auto  # auto | function_calling | json_schema | json_mode
# LLM_MAX_RPM=0               # client-side requests/minute cap (0 = off)
# LLM_MAX_RETRIES=3

# --- Ingestion and chunking (tokens) ---
# USE_DOCLING=true
# CHUNK_MAX_TOKENS=512
# CHUNK_MIN_TOKENS=80
# CHUNK_OVERLAP_TOKENS=64
# ENRICH_MAX_CHARS=12000

# --- Retrieval: semantic + BM25 -> RRF -> LLM rerank ---
# TOP_K=6
# CANDIDATE_K=20
# SEMANTIC_WEIGHT=1.0
# BM25_WEIGHT=1.0
# RRF_K=60
# RERANKER=llm                # llm | none (none is much faster on Ollama)
# RERANK_TOP_N=10
# RERANK_CONCURRENCY=4
# RERANK_MAX_CHARS=1200

# --- Answering, guardrails, routing ---
# CONFIDENCE_THRESHOLD=0.55   # below this: routing + low-confidence gap
# MIN_RETRIEVAL_SCORE=0.25
# HISTORY_MESSAGES=6
# GUARDRAILS_LLM=true         # false skips the LLM classifier (heuristics still run)
# ROUTING_MAX_PEOPLE=3

# --- Monitoring alerts ---
# ALERT_MIN_ANSWER_RATE=0.6
# ALERT_MAX_NEGATIVE_FEEDBACK_RATE=0.2
# ALERT_MIN_MEAN_CONFIDENCE=0.5
# ALERT_MIN_CITATION_VALID_RATIO=0.9
# ALERT_MAX_P95_LATENCY_MS=20000
# ALERT_BASELINE_DROP_PCT=0.15
# ALERT_MIN_SAMPLES=5

# --- Storage and API (relative paths resolve from backend/) ---
# DATA_DIR=../data
# CHROMA_DIR=./storage/chroma
# CHROMA_COLLECTION=fastchip
# SQLITE_PATH=./storage/app.db
# CORS_ORIGINS=http://localhost:5173
